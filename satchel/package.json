{
  "name": "satchel",
  "version": "1.1.0",
  "description": "Satchel: Almanac, Margin, Ledger, Stride and Tunnel behind one shared sign-in.",
  "author": "Satchel",
  "main": "server/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "npm --prefix ../almanac install && npm --prefix ../almanac run build && node scripts/build-landings.cjs",
    "start": "node server/start.cjs",
    "start:hosted": "node server/hosted.cjs",
    "dev": "node server/start.cjs",
    "test": "node test/run-all.cjs",
    "desktop": "electron desktop/main.cjs",
    "build:desktop": "electron-builder --config desktop/builder.cjs --win nsis --x64 --publish never",
    "icon:desktop": "electron desktop/make-icon.cjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "nodemailer": "^10.6.1"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "overrides": {
    "global-agent": "4.1.3",
    "minimatch@>=7.0.0 <11.0.1": "11.0.9"
  }
}
